<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Card" Width="326" Padding="14,11,14,10" CornerRadius="17"
        Background="#171A22" BorderBrush="#464132" BorderThickness="1"
        TextElement.FontFamily="Segoe UI, Microsoft YaHei UI" TextElement.Foreground="#F6F3EA">
  <Border.Resources>
    <Style x:Key="Small" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#B7B8C7"/>
    </Style>
    <Style x:Key="Metric" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </Border.Resources>
  <StackPanel>
    <Grid x:Name="Header" Background="Transparent" Cursor="Hand">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="78"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="18,0,4,0" VerticalAlignment="Center">
        <TextBlock Text="Today" FontSize="13" FontWeight="SemiBold" Foreground="#A7D8DC"/>
        <StackPanel Orientation="Horizontal" Margin="0,1,0,3">
          <TextBlock x:Name="Total" Text="···" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="tokens" Foreground="#B7B8C7" FontSize="11" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
        </StackPanel>
      </StackPanel>
      <ContentControl x:Name="Mascot" Grid.Column="1" Width="76" Height="76"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
    <Grid Margin="18,4,2,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Cost" Style="{StaticResource Small}" Text="正在读取本机用量…" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="Weekly" Grid.Column="1" Margin="8,0,0,0"
                 Style="{StaticResource Small}" Text="周剩余 —" Foreground="#A7D8DC"/>
    </Grid>
    <StackPanel x:Name="Details" Visibility="Collapsed" Margin="0,10,0,1">
      <Border Height="1" Background="#353440" Margin="0,0,0,10"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="22"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="输入" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="Input" Style="{StaticResource Metric}"/>
          </DockPanel>
          <DockPanel Margin="0,3,0,0">
            <TextBlock DockPanel.Dock="Left" Text="缓存" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="Cached" Style="{StaticResource Metric}"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="输出" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="Output" Style="{StaticResource Metric}"/>
          </DockPanel>
          <DockPanel Margin="0,3,0,0">
            <TextBlock DockPanel.Dock="Left" Text="命中率" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="CacheRate" Style="{StaticResource Metric}" Foreground="#FFCB5F"/>
          </DockPanel>
        </StackPanel>
      </Grid>
      <ProgressBar x:Name="CacheBar" Maximum="100" Height="4" Margin="0,9,0,10"
                   Background="#30313D" Foreground="#FFCB5F" BorderThickness="0"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="22"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="最近一次调用" Style="{StaticResource Small}" VerticalAlignment="Center"/>
        <TextBlock x:Name="RecentTokens" Grid.Column="2" Style="{StaticResource Metric}"/>
        <TextBlock x:Name="RecentTime" Grid.Row="1" Style="{StaticResource Small}" Margin="0,3,0,0"/>
        <TextBlock x:Name="RecentModel" Grid.Row="1" Grid.Column="2" Style="{StaticResource Small}"
                   TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
      </Grid>
      <Border Height="1" Background="#353440" Margin="0,10,0,7"/>
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="本机日志 · 按日汇总" Style="{StaticResource Small}"/>
        <TextBlock Text="金额与 credits 为估算" TextAlignment="Right" Style="{StaticResource Small}"/>
      </DockPanel>
      <TextBlock x:Name="Note" Margin="0,6,0,0" Style="{StaticResource Small}" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
  </StackPanel>
</Border>
