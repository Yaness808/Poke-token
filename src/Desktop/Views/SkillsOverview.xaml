<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.Resources>
    <DataTemplate x:Key="ExtensionDetails">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Foreground="{DynamicResource ComicMuted}" FontSize="12" Margin="0,2,0,4" TextWrapping="Wrap">
            <Run Text="{Binding Kind, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Source, Mode=OneWay}"/>
            <Run Text="{Binding VersionLabel, Mode=OneWay}"/><Run Text="{Binding SkillCountLabel, Mode=OneWay}"/>
          </TextBlock>
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="19"/>
        </StackPanel>
        <Border x:Name="Badge" Grid.Column="1" VerticalAlignment="Top" Background="#EFE4D5" Padding="7,2" CornerRadius="5">
          <TextBlock x:Name="StatusText" Text="{Binding Status}" Foreground="{DynamicResource ComicInk}" FontSize="12"/>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="已启用">
          <Setter TargetName="Badge" Property="Background" Value="#E1EBCD"/>
          <Setter TargetName="StatusText" Property="Foreground" Value="#354C22"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="已停用">
          <Setter TargetName="Badge" Property="Background" Value="{DynamicResource ComicHighlight}"/>
          <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource ComicAccent}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="PluginWithSkills">
      <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Header="{Binding}" HeaderTemplate="{StaticResource ExtensionDetails}"
                AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="展开或收起插件附带的技能">
        <Expander.Template>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            AutomationProperties.Name="{Binding Name}" Cursor="Hand">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Tile" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="5"
                            Padding="3,2">
                      <DockPanel>
                        <Path x:Name="Chevron" DockPanel.Dock="Left" Width="8" Height="11" Margin="3,4,8,0"
                              VerticalAlignment="Top" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                              Stroke="{DynamicResource ComicAccent}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Data="M 1,1 L 6,6 L 1,11"/>
                        <ContentPresenter/>
                      </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ComicPaper}"/>
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource ComicOutline}"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chevron" Property="RenderTransform">
                          <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                        </Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="SkillList" Visibility="Collapsed"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="SkillList" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Expander.Template>
        <ItemsControl ItemsSource="{Binding BundledSkills}" Margin="18,4,2,0" AutomationProperties.Name="插件附带的技能">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource ComicRule}" Padding="10,7">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ExtensionDetails}"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
    </DataTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
    <DockPanel>
      <Button x:Name="MaximizeRestore" DockPanel.Dock="Right" Width="76" Height="30" Margin="10,0,0,0"
              Content="最大化" AutomationProperties.Name="最大化窗口"/>
      <TextBlock x:Name="Heading" Text="Skills 总览" FontSize="22" FontWeight="SemiBold"/>
    </DockPanel>
    <TextBlock Text="按插件或技能名称搜索" Foreground="{DynamicResource ComicMuted}" Margin="0,2,0,8"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="144"/>
        <ColumnDefinition Width="104"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="Search" Height="32" Padding="8,3" Margin="0,0,8,0" VerticalContentAlignment="Center"
               AutomationProperties.Name="搜索插件或技能名称" Background="{DynamicResource ComicInset}"
               BorderBrush="{DynamicResource ComicRule}" SelectionBrush="{DynamicResource ComicHighlight}"/>
      <ComboBox x:Name="Purpose" Grid.Column="1" Margin="0,0,8,0" Style="{DynamicResource ComicFilter}"
                AutomationProperties.Name="按功能分类筛选"/>
      <ComboBox x:Name="Category" Grid.Column="2" SelectedIndex="0" Style="{DynamicResource ComicFilter}"
                AutomationProperties.Name="按类型筛选">
        <ComboBoxItem Content="全部类型"/>
        <ComboBoxItem Content="插件"/>
        <ComboBoxItem Content="独立技能"/>
      </ComboBox>
    </Grid>
    <Button x:Name="ShowAllMatches" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,7,0,0"
            AutomationProperties.HelpText="清除用途和类型筛选，保留搜索内容"/>
  </StackPanel>
  <Border Grid.Row="1" Background="{DynamicResource ComicInset}" BorderBrush="{DynamicResource ComicRule}"
          BorderThickness="1" CornerRadius="8" Padding="6,2">
    <Grid>
      <ListBox x:Name="Entries" Background="Transparent" BorderThickness="0"
               AutomationProperties.Name="插件和技能列表" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
               VirtualizingStackPanel.VirtualizationMode="Recycling">
        <ListBox.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource ComicPaper}" CornerRadius="5" Padding="9,5" Margin="0,6,0,0">
                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ComicAccent}" FontWeight="SemiBold"/>
                </Border>
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ListBox.GroupStyle>
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Row" Background="Transparent" Padding="8,9"
                          BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ComicRule}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Row" Property="Background" Value="{DynamicResource ComicPaper}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
              <ContentControl.Style>
                <Style TargetType="ContentControl">
                  <Setter Property="ContentTemplate" Value="{StaticResource ExtensionDetails}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasBundledSkills}" Value="True">
                      <Setter Property="ContentTemplate" Value="{StaticResource PluginWithSkills}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ContentControl.Style>
            </ContentControl>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="Empty" Text="正在读取 Codex 的插件和技能…" TextWrapping="Wrap" TextAlignment="Center"
                 Foreground="{DynamicResource ComicMuted}" VerticalAlignment="Center" HorizontalAlignment="Center"
                 Margin="16" IsHitTestVisible="False"/>
    </Grid>
  </Border>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
    <Thumb x:Name="ResizeHandle" DockPanel.Dock="Right" Width="22" Height="26" Margin="7,0,-4,0"
           Cursor="SizeNWSE" ToolTip="拖动调整窗口大小" AutomationProperties.Name="调整窗口大小">
      <Thumb.Template>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent" Padding="4">
            <Path Width="13" Height="13" VerticalAlignment="Bottom" HorizontalAlignment="Right" Stretch="Uniform"
                  Stroke="{DynamicResource ComicMuted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 1,12 L 12,1 M 6,12 L 12,6 M 11,12 L 12,11"/>
          </Border>
        </ControlTemplate>
      </Thumb.Template>
    </Thumb>
    <Button DockPanel.Dock="Right" Content="关闭" Width="72" IsCancel="True" Style="{DynamicResource ComicPrimaryButton}"/>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0">
      <Button x:Name="ZoomOut" Content="−" Width="34" FontSize="14" ToolTip="缩小列表"
              AutomationProperties.Name="缩小列表"/>
      <Button x:Name="ZoomReset" Content="100%" Width="56" Margin="3,0" ToolTip="恢复列表默认缩放"
              AutomationProperties.Name="恢复列表默认缩放"/>
      <Button x:Name="ZoomIn" Content="+" Width="34" FontSize="14" ToolTip="放大列表"
              AutomationProperties.Name="放大列表"/>
    </StackPanel>
    <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
               Foreground="{DynamicResource ComicMuted}" FontSize="12"/>
  </DockPanel>
</Grid>
