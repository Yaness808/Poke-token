<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="264" Padding="14,11,14,12" Background="#FFF8E7"
        CornerRadius="19" BorderThickness="2" BorderBrush="#694538"
        TextElement.FontFamily="Segoe UI, Microsoft YaHei UI" TextElement.Foreground="#372820">
  <Border.Resources>
    <Style x:Key="Small" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#694D41"/>
    </Style>
    <Style x:Key="Metric" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
  </Border.Resources>
  <StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
      <TextBlock Text="Today" FontSize="11" FontWeight="Bold" Foreground="#A85129" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock x:Name="Total" Text="···" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="tokens" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="5,0,0,0"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Cost" Style="{StaticResource Small}" Text="正在读取本机用量…" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="Weekly" Grid.Column="1" Margin="8,0,0,0"
                 Style="{StaticResource Small}" Text="周剩余 —"/>
    </Grid>
    <StackPanel Margin="0,8,0,0">
      <Border Height="1" Background="#E9D8C8" Margin="0,0,0,6"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="输入" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="Input" Style="{StaticResource Metric}"/>
          </DockPanel>
          <DockPanel Margin="0,3,0,0">
            <TextBlock DockPanel.Dock="Left" Text="缓存" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="Cached" Style="{StaticResource Metric}"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="输出" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="Output" Style="{StaticResource Metric}"/>
          </DockPanel>
          <DockPanel Margin="0,3,0,0">
            <TextBlock DockPanel.Dock="Left" Text="命中率" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="CacheRate" Style="{StaticResource Metric}" Foreground="#A24F25"/>
          </DockPanel>
        </StackPanel>
      </Grid>
      <ProgressBar x:Name="CacheBar" Maximum="100" Height="3" Margin="0,6,0,7"
                   Background="#EFDDCC" Foreground="#C5744A" BorderThickness="0"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="最近一次调用" Style="{StaticResource Small}" VerticalAlignment="Center"/>
        <TextBlock x:Name="RecentTokens" Grid.Column="2" Style="{StaticResource Metric}"/>
        <TextBlock x:Name="RecentTime" Grid.Row="1" Style="{StaticResource Small}" Margin="0,3,0,0"/>
        <TextBlock x:Name="RecentModel" Grid.Row="1" Grid.Column="2" Style="{StaticResource Small}"
                   TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
      </Grid>
      <Border Height="1" Background="#E9D8C8" Margin="0,7,0,6"/>
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="本机日志 · 按日汇总" Style="{StaticResource Small}"/>
        <TextBlock Text="金额与 credits 为估算" TextAlignment="Right" Style="{StaticResource Small}"/>
      </DockPanel>
      <TextBlock x:Name="Note" Margin="0,6,0,0" Style="{StaticResource Small}" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
  </StackPanel>
</Border>
