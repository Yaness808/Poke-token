<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#151B25">
  <Grid.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EEF3F7"/>
      <Setter Property="TextElement.FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,5"/>
    </Style>
  </Grid.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="关都图鉴" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="151 只伙伴 · 用中文、英文或编号搜索" Foreground="#A6C4CB" Margin="0,4,0,10"/>
      <TextBox x:Name="Search" Height="34" Padding="8,3" FontSize="15" VerticalContentAlignment="Center"
               AutomationProperties.Name="搜索关都图鉴"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>
      <ListBox x:Name="Entries" Background="#202A37" BorderThickness="0" Foreground="#F0F5FB"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="5,5">
              <TextBlock Text="{Binding Number}" Foreground="#A4DFD3" Width="55"/>
              <TextBlock Text="{Binding Name}" FontSize="14"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="2" Background="#203039" CornerRadius="16" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Image x:Name="Artwork" Stretch="Uniform" Margin="4"/>
          <TextBlock x:Name="Status" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                     Foreground="#BED3DB" Margin="10"/>
          <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock x:Name="SpeciesName" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock x:Name="SpeciesInfo" Foreground="#A4DFD3" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
      <TextBlock x:Name="Count" DockPanel.Dock="Left" Foreground="#A6C4CB" VerticalAlignment="Center"/>
      <Button x:Name="SelectPokemon" DockPanel.Dock="Right" Content="选择这只" IsDefault="True" IsEnabled="False"/>
      <Button DockPanel.Dock="Right" Content="取消" IsCancel="True" Margin="0,0,8,0"/>
    </DockPanel>
  </Grid>
</Grid>
