<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
    <TextBlock x:Name="Heading" Text="切换宝可梦" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="按中文名、英文名或图鉴编号搜索" Foreground="{DynamicResource ComicMuted}" Margin="0,2,0,8"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="146"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="Search" Height="32" Padding="8,3" VerticalContentAlignment="Center" Margin="0,0,8,0"
               Background="{DynamicResource ComicInset}" BorderBrush="{DynamicResource ComicRule}"
               SelectionBrush="{DynamicResource ComicHighlight}" AutomationProperties.Name="搜索宝可梦"/>
      <ComboBox x:Name="Generation" Grid.Column="1" SelectedIndex="0" Style="{DynamicResource ComicFilter}"
                AutomationProperties.Name="筛选宝可梦世代">
        <ComboBoxItem Content="全部世代"/>
        <ComboBoxItem Content="第一世代 · 关都"/>
        <ComboBoxItem Content="第二世代 · 城都"/>
        <ComboBoxItem Content="第三世代 · 丰缘"/>
        <ComboBoxItem Content="第四世代 · 神奥"/>
        <ComboBoxItem Content="第五世代 · 合众"/>
        <ComboBoxItem Content="第六世代 · 卡洛斯"/>
        <ComboBoxItem Content="第七世代 · 阿罗拉"/>
      </ComboBox>
      <CheckBox x:Name="FavoritesOnly" Grid.Column="2" Content="仅看收藏"
                VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="12,0,0,0"/>
    </Grid>
  </StackPanel>
  <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="5*"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="6*"/>
    </Grid.ColumnDefinitions>
    <ListBox x:Name="Entries" Background="{DynamicResource ComicInset}" BorderBrush="{DynamicResource ComicRule}"
             Padding="3" AutomationProperties.Name="宝可梦列表"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingStackPanel.VirtualizationMode="Recycling">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" CornerRadius="4" Background="Transparent" Padding="8,5" BorderThickness="1">
                  <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource ComicPaper}"/>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource ComicHighlight}"/>
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ComicOutline}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Number}" Foreground="{DynamicResource ComicMuted}" Width="48"/>
            <TextBlock Text="{Binding Name}" FontSize="14"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Column="2" Background="{DynamicResource ComicInset}" BorderBrush="{DynamicResource ComicRule}"
            BorderThickness="1" CornerRadius="9" Padding="12,8,12,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image x:Name="Artwork" Stretch="Uniform" Margin="4,4,4,8" AutomationProperties.Name="选中宝可梦的立绘"/>
        <TextBlock x:Name="Status" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource ComicMuted}" Margin="8"/>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
          <TextBlock x:Name="SpeciesName" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
          <TextBlock x:Name="SpeciesInfo" Foreground="{DynamicResource ComicMuted}" TextAlignment="Center" TextWrapping="Wrap"
                     Margin="0,2,0,0"/>
          <Button x:Name="Favorite" HorizontalAlignment="Center" Margin="0,8,0,0" IsEnabled="False">
            <StackPanel Orientation="Horizontal">
              <Path x:Name="FavoriteStar" Width="17" Height="17" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"
                    Fill="Transparent" Stroke="{DynamicResource ComicAccent}" StrokeThickness="1.2" StrokeLineJoin="Round"
                    Data="M 8,0.8 L 10.2,5.6 15.4,6.2 11.6,9.8 12.6,15 8,12.4 3.4,15 4.4,9.8 0.6,6.2 5.8,5.6 Z"/>
              <TextBlock x:Name="FavoriteLabel" Text="收藏"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
    <TextBlock x:Name="Count" DockPanel.Dock="Left" Foreground="{DynamicResource ComicMuted}" VerticalAlignment="Center"/>
    <Button x:Name="SelectPokemon" DockPanel.Dock="Right" Content="选择这只" IsDefault="True" IsEnabled="False"
            Style="{DynamicResource ComicPrimaryButton}"/>
    <Button DockPanel.Dock="Right" Content="取消" IsCancel="True" Margin="0,0,8,0"/>
  </DockPanel>
</Grid>
